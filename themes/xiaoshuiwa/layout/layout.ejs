<%
let documentTitle = page.title;
if (!documentTitle && is_category()) documentTitle = page.category;
if (!documentTitle && is_archive()) documentTitle = '归档';
%>
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= documentTitle && !is_home() ? documentTitle + '｜' : '' %><%= config.title %></title>
  <meta name="description" content="<%= strip_html(page.description || config.description) %>">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%231d7180'/%3E%3Cellipse cx='32' cy='32' rx='22' ry='10' fill='none' stroke='white' stroke-width='3' opacity='.5'/%3E%3Cellipse cx='32' cy='32' rx='11' ry='5' fill='none' stroke='white' stroke-width='3'/%3E%3C/svg%3E">
  <link rel="stylesheet" href="<%- url_for('/styles.css') %>">
  <script src="<%- url_for('/site.js') %>" defer></script>
</head>
<body>
  <%- partial('_partial/header') %>
  <main><%- body %></main>
  <%- partial('_partial/footer') %>
</body>
</html>
