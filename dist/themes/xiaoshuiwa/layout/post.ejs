<%
const articleText = strip_html(page.content).replace(/\s+/g, '');
const readingMinutes = Math.max(1, Math.ceil(articleText.length / 400));
%>
<header class="article-header">
  <div class="eyebrow"><%= page.eyebrow || (page.categories && page.categories.length ? page.categories.first().name : 'ARTICLE') %></div>
  <h1><%= page.title %></h1>
  <div class="article-meta">
    <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY 年 M 月 D 日') %></time>
    <span>约 <%= readingMinutes %> 分钟阅读</span>
  </div>
</header>
<article class="article-body<%= page.poem ? ' poem-body' : '' %>">
  <%- page.content %>
  <nav class="article-nav" aria-label="文章翻页">
    <% if (page.prev) { %><a href="<%- url_for(page.prev.path) %>">← 上一篇：<%= page.prev.title %></a><% } else { %><a href="<%- url_for('/archive/') %>">← 返回归档</a><% } %>
    <% if (page.next) { %><a href="<%- url_for(page.next.path) %>">下一篇：<%= page.next.title %> →</a><% } else { %><a href="<%- url_for('/archive/') %>">返回归档 →</a><% } %>
  </nav>
</article>
